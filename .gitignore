# ═══════════════════════════════════════════════════════════════
# Pi Jam FAST Assessment Platform — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environments ─────────────────────────────────────────
.venv/
venv/
ENV/
env/
.env
.env.*

# ── Database (runtime data — never commit live data) ─────────────
backend/assessment.db
backend/assessment.db-shm
backend/assessment.db-wal
*.db
*.sqlite
*.sqlite3

# ── Runtime Uploads & Generated Reports ──────────────────────────
# Keep the folder structure (.gitkeep files) but ignore all content
backend/uploads/pdfs/*
!backend/uploads/pdfs/.gitkeep
backend/uploads/exports/*
!backend/uploads/exports/.gitkeep

# ── Generated Card Images & PDFs (regenerate with generate_cards.py) ──
output/*
!output/.gitkeep

# ── SSL Certificates & Keys (NEVER commit private keys!) ─────────
*.pem
*.key
*.crt
*.p12
*.pfx
cert.pem
key.pem

# ── Auto-generated Files ─────────────────────────────────────────
mobile_connect_qr.png

# ── Node / Frontend Build ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
dist/
.cache/

# ── Android Capacitor Build ──────────────────────────────────────
# The android/ folder is generated by 'npx cap add android' and
# rebuilt via 'npx cap sync'. Don't commit build artifacts.
android/app/build/
android/.gradle/
android/local.properties
*.apk
*.aab
*.keystore
*.jks

# ── macOS / Windows / Editor Junk ────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/settings.json
*.suo
*.user

# ── Testing Artifacts ─────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/
