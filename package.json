{
  "name": "pijam-fast-assessment",
  "version": "2.0.0",
  "description": "Pi Jam Foundation Formative Classroom Assessment Platform",
  "main": "frontend/app.js",
  "scripts": {
    "start": "python run_server.py",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:apk": "npx cap copy android && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "keywords": [
    "education",
    "assessment",
    "computer-vision",
    "aruco",
    "pi-jam-foundation"
  ],
  "author": "ET617 Course Project",
  "license": "MIT"
}
